# Copy to `.env.local` (gitignored). Same file can be symlinked across worktrees.

# Gemini — survives until you rotate the key in Google AI Studio (no 30‑day app limit).
# After editing, restart `next dev` so the server picks up changes.
GOOGLE_API_KEY=

# Also accepted (same file, same restart rule):
# GOOGLE_GENERATIVE_AI_API_KEY=
# GEMINI_API_KEY=

# Optional default model for server routes that read GEMINI_MODEL
# GEMINI_MODEL=gemini-2.5-flash

# Optional — Firecrawl-backed web search
# FIRECRAWL_API_KEY=

# --- Share projects / tasks / CRM across folders (e.g. main + updates worktrees) ---
# Use the same absolute path in every clone. Data is written next to your home dir, not in git.
# IRONWOOD_WORKSPACE_FILE=/Users/yourname/.ironwood-workspace.json
# NEXT_PUBLIC_IRONWOOD_WORKSPACE_SYNC=1
