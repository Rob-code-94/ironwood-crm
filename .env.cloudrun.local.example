# Copy to .env.cloudrun.local (gitignored). Use the same project as Cloud Run in console.
#
# IWC SASS-CRM (correct production target for this app):
#   Project ID:   iwc-saas-crm
#   Project #:    316650805051
#   Service URL:  https://ironwood-planner-316650805051.us-central1.run.app/
#
# Deploys always use GCP_PROJECT with gcloud — not the URL. Wrong project ID = wrong hostname.

GCP_PROJECT=iwc-saas-crm
CLOUD_RUN_REGION=us-central1
CLOUD_RUN_SERVICE=ironwood-planner
CLOUD_RUN_URL=https://ironwood-planner-316650805051.us-central1.run.app/

