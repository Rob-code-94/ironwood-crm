# Copy to .env.cloudrun.local (gitignored) and set values.
# Project ID is the string gcloud expects (may differ from project number 316650805051).
# Resolve: gcloud projects describe 316650805051 --format='value(projectId)'

GCP_PROJECT=
CLOUD_RUN_REGION=us-central1
CLOUD_RUN_SERVICE=ironwood-planner
CLOUD_RUN_URL=https://ironwood-planner-316650805051.us-central1.run.app/
