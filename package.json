{
  "name": "ironwood-crm",
  "version": "0.1.0",
  "description": "Ironwood Planner desktop client",
  "author": {
    "name": "Ironwood",
    "email": "support@ironwoodplanner.app"
  },
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev --webpack -p 3000",
    "dev:turbo": "next dev --turbopack -p 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "clean": "rm -rf .next",
    "deploy:cloud-run": "bash scripts/deploy-cloud-run.sh",
    "electron": "electron .",
    "electron:dev": "concurrently -k -n next,electron -c green,cyan \"npm:dev\" \"wait-on -t 60000 tcp:3000 && cross-env IRONWOOD_DEV_URL=http://127.0.0.1:3000 electron .\"",
    "electron:bundle": "node scripts/copy-electron-bundle.mjs",
    "electron:build": "rm -rf dist electron/build && npm run build && npm run electron:bundle",
    "electron:pack": "npm run electron:build && electron-builder --mac --dir",
    "electron:dist": "npm run electron:build && electron-builder --mac dmg zip",
    "electron:release": "npm run electron:build && electron-builder --mac dmg zip --publish always"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.53",
    "@assistant-ui/react": "^0.12.19",
    "@assistant-ui/react-ai-sdk": "^1.3.16",
    "@assistant-ui/react-markdown": "^0.12.6",
    "@base-ui/react": "^1.3.0",
    "@google/genai": "^1.46.0",
    "@google/generative-ai": "^0.24.1",
    "@hookform/resolvers": "^5.2.2",
    "@phosphor-icons/react": "^2.1.10",
    "@remixicon/react": "^4.9.0",
    "@tanstack/react-table": "^8.21.3",
    "ai": "^6.0.140",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.8.3",
    "firebase-admin": "^13.7.0",
    "input-otp": "^1.4.2",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.555.0",
    "next": "16.2.0",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.71.2",
    "react-resizable-panels": "^4.7.3",
    "recharts": "^2.15.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "web-push": "^3.6.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/wait-on": "^5.3.4",
    "@types/web-push": "^3.6.4",
    "babel-plugin-react-compiler": "1.0.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^41.2.1",
    "electron-builder": "^26.8.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.0",
    "tailwindcss": "^4",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "wait-on": "^9.0.5"
  }
}
